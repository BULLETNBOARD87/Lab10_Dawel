<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioMenuItem?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.Pane?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="155.0" prefWidth="270.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.lab10menu_dawel.MainmenuController">
   <children>
      <MenuBar layoutY="2.0" prefHeight="25.0" prefWidth="270.0">
        <menus>
          <Menu mnemonicParsing="false" text="File">
            <items>
                  <MenuItem fx:id="newItem" mnemonicParsing="false" text="New" />
                  <MenuItem fx:id="openItem" mnemonicParsing="false" text="Open" />
                  <MenuItem fx:id="closeItem" mnemonicParsing="false" text="Close" />
                  <MenuItem fx:id="saveItem" mnemonicParsing="false" text="Save As" />
            </items>
          </Menu>
            <Menu mnemonicParsing="false" text="Edit">
              <items>
                <MenuItem fx:id="gridItem" mnemonicParsing="false" text="Use GridLines" />
                  <MenuItem fx:id="copyItem" mnemonicParsing="false" text="Copy" />
                  <Menu fx:id="searchMenu" mnemonicParsing="false" text="Search">
                    <items>
                      <MenuItem fx:id="findItem" mnemonicParsing="false" text="Find" />
                        <MenuItem fx:id="replaceItem" mnemonicParsing="false" text="Replace" />
                    </items>
                  </Menu>
              </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Settings">
               <items>
                  <RadioMenuItem fx:id="smallButton" mnemonicParsing="false" text="Small">
                     <toggleGroup>
                        <ToggleGroup fx:id="radioGroup" />
                     </toggleGroup>
                  </RadioMenuItem>
                  <RadioMenuItem fx:id="mediumButton" mnemonicParsing="false" text="Medium" toggleGroup="$radioGroup" />
                  <RadioMenuItem fx:id="largeButton" mnemonicParsing="false" text="Large" toggleGroup="$radioGroup" />
               </items>
            </Menu>
        </menus>
      </MenuBar>
   </children>
</Pane>
